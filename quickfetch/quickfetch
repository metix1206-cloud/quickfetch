#!/bin/bash

running=true

waiting=1

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

os=$(grep "^PRETTY_NAME=" /etc/os-release | cut -d'"' -f2)

os_id=$(grep "^ID=" /etc/os-release | cut -d'=' -f2 | tr -d '"')

while [ "$#" -gt 0 ]; do
	case "$1" in
		--no-color)
			nocolor=true
			shift
			;;
		--intervall)
			waiting="$2"
			shift 2
			;;
		--logo)
			if [ "$2" = "list" ]; then
				clear
				find "$SCRIPT_DIR/assets_quickfetch" -name "*.txt" -exec basename {} .txt \; | sort
				exit 0
			fi
			os_id="$2"
			shift 2
			;;
		--once)
			running=false
			shift
			;;
		--help)
			cat <<- EOF
			quickfetch - a simple system info tool

			Usage:
			  quickfetch [OPTION]

			Options:
			  --logo <name>		use a specific logo instead of auto-detection
			  --once		show info once and exit, no live updates
			  --intervall <sec>	set update interval in seconds (default: 1)
			  --help		show this help message
			  --no-color		disables the color
			EOF
			exit 0
			;;
		*)
			shift
			;;
	esac
done

first_letter="${os_id:0:1}"
logo_file=$(find "$SCRIPT_DIR/assets_quickfetch/${first_letter}" -iname "${os_id}.txt" 2>/dev/null | head -1)

if [ -n "$logo_file" ] && [ -f "$logo_file" ]; then
	color_line=$(grep "^${os_id}:" "$SCRIPT_DIR/assets_quickfetch/colors.txt")
	col1=$(echo "$color_line" | cut -d':' -f2)
	col2=$(echo "$color_line" | cut -d':' -f3)

	if [ -z "$col1" ]; then col1="36"; fi
	if [ -z "$col2" ]; then col2="36"; fi

	COLOR1=$(printf '\033[1;%sm' "$col1")
	COLOR2=$(printf '\033[1;%sm' "$col2")
	RST=$(printf '\033[0m')

	if [ "$nocolor" = "true" ]; then
		COLOR1=""
		COLOR2=""
		RST=""
	fi

	logo=$(sed "s/\$1/${COLOR1}/g; s/\$2/${COLOR2}/g" "$logo_file")
	logo=$(awk -v c1="$COLOR1" -v rst="$RST" '
	BEGIN { cur = c1 }
	{
		line = $0
		lastcode = cur
		while (match(line, /\033\[[0-9;]*m/)) {
			lastcode = substr(line, RSTART, RLENGTH)
			line = substr(line, RSTART + RLENGTH)
		}
	print cur $0 rst
	cur = lastcode
	}' <<< "$logo")
else
	logo="(no logo: $os_id found)"
fi

lIP=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+')
if [ -z "$lIP" ]; then
	lIP=$(ip addr show | grep "inet " | grep -v 127.0.0.1 | grep -oP '\d+\.\d+\.\d+\.\d+' | head -1)
fi

if [ -z "$lIP" ]; then
	lIP=$(ip route get 2606:4700:4700::1111 2>/dev/null | grep -oP 'src \K\S+')
fi

if [ -z "$lIP" ]; then
	lIP="not connected"
fi

pIP=$(curl -s --max-time 2 ifconfig.me)
if [ -z "$pIP" ]; then
	pIP="not available"
fi

kernel=$(uname -r)

shell=$SHELL

RES=$(if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
	r=$(wlr-randr 2>/dev/null | grep current | awk '{print $1}')
	if [ -z "$r" ] && command -v kscreen-doctor &> /dev/null; then
		r=$(kscreen-doctor -o 2>/dev/null | grep -oP '\d+x\d+' | head -1)
	fi
	echo "$r"
else
	xrandr 2>/dev/null | grep " connected" | head -1 | grep -oP '\d+x\d+'
fi)

if [ -z "$RES" ]; then
	RES="not available"
fi

make_bar() {
	local percent="$1"
	local label="$2"
	local totalbar="${3:-10}"
	local filled=$(awk "BEGIN { printf \"%.0f\", ($percent/100)*$totalbar }")
	local empty=$(( totalbar - filled ))
	local bar=""; for i in $(seq 1 $filled); do bar+="${COLOR1}█${RST}"; done
	for i in $(seq 1 $empty); do bar+="-"; done
	echo "[ $bar ] $label"
}

bat_path=$(find /sys/class/power_supply -maxdepth 1 -iname "BAT*" | head -1)
ac_path=$(find /sys/class/power_supply -maxdepth 1 \( -iname "AC*" -o -iname "ADP*" \) | head -1)

while $running; do
	
	if [ -n "$bat_path" ] && [ -f "$bat_path/capacity" ]; then
		battery=$(cat "$bat_path/capacity")
	else
		battery="0"
	fi
	
	if [ -n "$ac_path" ] && [ -f "$ac_path/online" ]; then
		if [ "$(cat "$ac_path/online")" = "1" ]; then
			charging=" [ AC Connected ]"
		else
			charging=" [ Discharging ]"
		fi
	else
		charging=""
	fi

	ram_used=$(free -m | awk 'NR==2 {printf "%.1f", $3/1024}')
	ram_total=$(free -m | awk 'NR==2 {printf "%.1f", $2/1024}')
	ram_percent=$(awk "BEGIN { if ($ram_total > 0) print ($ram_used/$ram_total)*100; else print 0 }")
	ram_bar=$(make_bar "$ram_percent" "${ram_used}/${ram_total}")

	disk_used=$(df -BG / | awk 'NR==2 {gsub("G","",$3); print $3}')
	disk_total=$(df -BG / | awk 'NR==2 {gsub("G","",$2); print $2}')
	disk_percent=$(awk "BEGIN { if ($disk_total > 0) print ($disk_used/$disk_total)*100; else print 0 }")
	disk_bar=$(make_bar "$disk_percent" "${disk_used}g/${disk_total}g")

	power_bar=$(make_bar "$battery" "${battery}%")

	if [ "$1" = "--once" ]; then
		running=false
	fi

	clear
	huser="$(whoami)@$HOSTNAME"
	lengh=${#huser}

	pm_info=""

	if command -v pacman &> /dev/null; then
		count=$(pacman -Q | wc -l)
		pm_info+="pacman ($count) "
	fi

	if command -v dnf &> /dev/null; then
		count=$(dnf list installed 2>/dev/null | wc -l)
		pm_info+="dnf ($count) "
	fi

	if command -v flatpak &> /dev/null; then
		count=$(flatpak list --app 2>/dev/null | wc -l)
		pm_info+="flatpak ($count) "
	fi

	if command -v apt &> /dev/null; then
		count=$(apt list --installed 2>/dev/null | tail -n +2 | wc -l)
		pm_info+="apt ($count) "
	fi

	if command -v dpkg &> /dev/null; then
		count=$(dpkg-query -W -f='${binary:Package}\n' 2>/dev/null | wc -l)
		pm_info+="dpkg ($count) "
	fi

	if command -v zypper &> /dev/null; then
		count=$(zypper se --installed-only 2>/dev/null | grep -c '^i')
		pm_info+="zypper ($count) "
	fi

	if [ -z "$pm_info" ]; then
		pm_info="unknown"
	fi

	info=$(cat <<- EOF
		${COLOR1}$huser${RST}
		${COLOR1}$(for sym in $(seq 0 $((lengh - 1))); do printf "-"; done)${RST}
		${COLOR1}SOFTWARE-INFO${RST}
		    --	Kernel:			$kernel
		    --	OS:			$os
		    --	Shell:			$shell
		    --	Host:			$HOSTNAME
		    --	USR:			$(whoami)
		    --	LOCAL-IP:		$lIP
		    --	PUBLIC-IP:		$pIP
	
		${COLOR1}HARDWARE-INFO${RST}
		    --	Disk:			${disk_bar}
		    --	RAM:			$ram_bar
		    --	Power:			$power_bar $charging
		    --	CPU:			$(grep 'model name' /proc/cpuinfo | head -1 | cut -d':' -f2 | xargs) ($(nproc) cores)
		    --	CPU-architecture:	$(uname -m)
		    --	Res:			$RES
		
		${COLOR1}SESSION-INFO${RST}
		    --	WM:			$XDG_CURRENT_DESKTOP
		    --	Session:		$XDG_SESSION_TYPE
		    --	Terminal:		$TERM
		    --	Package-Manager:	$pm_info
		    --	Uptime:			$(uptime -p)
	
		${COLOR1}------------------------------------------------------${RST}
		${COLOR1}		To Quit Press "q"${RST}
	
	EOF
	)

	echo "$logo" > /tmp/qf_logo.txt
	echo "$info" > /tmp/qf_info.txt
	
	max_width=$(echo "$logo" | sed 's/\x1b\[[0-9;]*m//g' | awk '{ if (length($0) > max) max = length($0) } END { print max + 4 }')

	paste /tmp/qf_logo.txt /tmp/qf_info.txt | awk -F'\t' -v width="$max_width" '{
		rest = $2
		for (i = 3; i <= NF; i++) rest = rest "\t" $i
		plain = $1
		gsub(/\033\[[0-9;]*m/, "", plain)
		padding = width - length(plain)
		if (padding < 0) padding = 0
		printf "%s%*s%s\n", $1, padding, "", rest
	}'
	read -t "$waiting" -n 1 taste
	if [ "$taste" = "q" ]; then
		break
		echo""
	fi
done
